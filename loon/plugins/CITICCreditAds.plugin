#!name=动卡空间去广告
#!desc=移除动卡空间开屏广告及各页面推广位。
#!openUrl=https://apps.apple.com/app/id561689048
#!author=MRXOAD[https://github.com/MRXOAD]
#!tag=去广告
#!system=iOS, iPadOS
#!loon_version=3.5.1(983)
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/8b/61/e2/8b61e2e5-7810-fdf5-9d66-ea6585050e02/AppIcon-0-0-1x_U007emarketing-0-9-0-sRGB-85-220.png/100x100bb.jpg

[Rule]
# 2026-11-24 强制动卡空间广告与开屏素材主机回落 TCP，避免 HTTP/3 QUIC 绕过下方 MITM 重写与开屏尺寸脚本。
AND,((DOMAIN,ump.szcdn.creditcard.ecitic.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,ump.sz.creditcard.ecitic.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,m.creditcard.citicbank.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,m.creditcard.ecitic.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
# 2026-11-18 从广告重写迁回，插件自持。动卡空间主网关 2026-09-23 已迁到 m.creditcard.citicbank.cn，
# 旧 ump.sz.creditcard.ecitic.com 不再请求但保留，防止回滚。
# 只收 dsp 程序化广告位与日志上报；首页金刚区功能图标（jgq-icon、top-big-icon）不收。
request if ${url} ~= /^https?:\/\/m\.creditcard\.(?:citicbank\.cn|ecitic\.com)\/citiccard\/mbk\/dkkj-gateway(?:-h5)?\/dkkj-market-web\/label\/L\/query\/fqhkjbdsp/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/m\.creditcard\.(?:citicbank\.cn|ecitic\.com)\/citiccard\/mbk\/dkkj-monitor-web\/logs/i then reject_dict(200)
# 广告位统一以 -dsp 结尾，两台网关（原生/H5）都按后缀收，覆盖日后新增的版位。
request if ${url} ~= /^https?:\/\/m\.creditcard\.(?:citicbank\.cn|ecitic\.com)\/citiccard\/mbk\/dkkj-gateway(?:-h5)?\/dkkj-market-web\/scene-info\/L\/query-[a-z0-9-]+-dsp/i then reject_dict(200)
# 统一客户营销平台开屏广告配置（2026-10-04 现场域换成 ump.szcdn，按已知 /adv 接口适配）。
# advantage、init-config、账户接口不匹配。
request if ${url} ~= /^https?:\/\/ump\.sz\.creditcard\.ecitic\.com\/citiccard\/cm-ump\/ump-gateway\/ump-net-app\/ump-net-app\/adv/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/ump\.szcdn\.creditcard\.ecitic\.com\/citiccard\/cm-ump\/ump-gateway\/ump-net-app\/ump-net-app\/adv(?:\/[^?#]*)?(?:\?[^#]*)?$/i then reject_dict(200)
# 2026-11-18 上游（R-Store eciticcc）另有 init-config 一条，属 App 初始化配置，返回空会让首页楼层改用默认值；
# 与交行 releaseConf 同类风险，未启用。实测确认只影响广告位后再取消注释：
# request if ${url} ~= /^https?:\/\/m\.creditcard\.ecitic\.com\/citiccard\/mbk\/appspace-getway\/getWay\/dkkj-system-web\/system\/v\d+\/init-config/i then reject(200)

[Script]
# 2026-10-07 15:10 调试级日志（DKKJ 11.23.0 冷启动）：get-app-resource 之后立刻请求 ump/img/ 下 31 张图，全部 750×1330；
# 下载 4 张看过，是带「广告」角标的整屏开屏（临额提升、境外立减、抽奖、出境游）。同一次启动里 m.citiccardcdn 的 appspace-img/icon/ 只有图标。
# 经过：10-04 按公开规则拦 appspace-img/icon/，10-06 放宽到 appspace-img/，都不是素材所在；10-07 临时扩到三台主机并弹诊断通知，
# 素材在当天才纳入的 ump.szcdn 上。现收回到这一个目录，诊断通知关闭（一次启动会弹 60 多条）。仍按尺寸判断，同目录其他尺寸的图不受影响。
response if ${url} ~= /^https:\/\/ump\.szcdn\.creditcard\.ecitic\.com\/ump\/img\/[^\/?#]+\.(?:png|jpe?g|gif|webp)(?:\?[^#]*)?$/i then script("https://raw.githubusercontent.com/MRXOAD/proxy-rules/main/loon/plugins/BankImageSize.js", "mode=splash") with tag="动卡空间开屏尺寸拦截", timeout=10, requires_body=true, binary_body_mode=true

[MITM]
hostname = ump.szcdn.creditcard.ecitic.com, ump.sz.creditcard.ecitic.com, m.creditcard.citicbank.cn, m.creditcard.ecitic.com
