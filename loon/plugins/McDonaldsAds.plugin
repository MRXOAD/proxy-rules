[Rewrite]
# 开屏启动页与营销弹窗。上游三条实际都在 api.mcd.cn/bff/portal 下、
# 且互相覆盖，合并成一条返回 200 空响应
request if ${url} ~= /^https?:\/\/api\.mcd\.cn\/bff\/portal\/(?:home\/splash|richpop)/i then reject(200)

[MITM]
hostname = api.mcd.cn
