#!name=YouTube去广告
#!desc=过滤 YouTube 视频、推荐流、搜索和 Shorts 的广告，保留 YouTube 与 YouTube Music 底栏；保留既有画中画、后台播放及翻译处理。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!openUrl=https://apps.apple.com/app/id544007664
#!author=Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile]
#!tag=去广告
#!system=iOS, iPadOS, macOS
#!system_version=15
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YouTube.png
#!date=2026-10-02 13:57:49
# 本地修改：rules/本地补充/可莉插件/YouTube_remove_ads.list（7 条）

[Argument]
# [本地禁用] blockUpload=switch, false, true, tag=隐藏上传按钮, desc=用于隐藏YouTube底栏的上传按钮
# [本地禁用] blockShorts=switch, false, true, tag=隐藏Shorts按钮, desc=用于隐藏YouTube底栏的Shorts按钮
# [本地禁用] blockImmersive=switch, false, true, tag=隐藏选段按钮, desc=用于隐藏YouTube Music底栏的选段按钮
captionLang=select, "zh-Hans", "zh-Hant", "ja", "ko", "en", "off", tag=字幕翻译语言, desc=需要把YouTube字幕翻译翻译为何种语言
debug=switch, false, true, tag=启用调试模式, desc=此插件的调试模式

[Script]
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|account\/get_setting|get_watch|log_event|config))(\?(.*))?$/i then script("https://raw.githubusercontent.com/MRXOAD/proxy-rules/main/loon/plugins/KeLee-YouTube_remove_ads_response.js", {${captionLang}, ${debug}}) with tag="YouTube去广告", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*/i then script("https://raw.githubusercontent.com/MRXOAD/proxy-rules/main/loon/plugins/KeLee-YouTube_remove_ads_request.js", {${captionLang}}) with tag="请求初始化", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event/i then script("https://raw.githubusercontent.com/MRXOAD/proxy-rules/main/loon/plugins/KeLee-YouTube_remove_ads_request.js", {${captionLang}, ${debug}}) with tag="请求日志事件", requires_body=true, binary_body_mode=true

[MitM]
hostname=*.googlevideo.com, youtubei.googleapis.com

[Rewrite]
request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$/i then reject(404)
