# 本地修改：rules/本地补充/可莉插件/CosmosPodcast_remove_ads.list（10 条）

[Rewrite]
# [本地禁用] response if ${url} ~= /^https:\/\/api\.xiaoyuzhoufm\.com\/v1\/discovery-feed\/list/i then response.json.jq("if (.data | type) == \"array\" then .data |= map(select(.type != \"DISCOVERY_HEADER\" and .type != \"DISCOVERY_BANNER\")) else . end")

request if ${url} ~= /^https:\/\/api\.xiaoyuzhoufm\.com\/v\d+\/flash(?:\?|$)/i then reject_dict(200)

# [本地禁用] request if ${url} ~= /^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/ai/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.xiaoyuzhoufm\.com\/v\d+\/search\/get(?:\?|$)/i then reject_dict(200)
# [本地禁用] request if ${url} ~= /^https?:\/\/api\.xiaoyuzhoufm\.com\/v\d\/category/i then reject_dict(200)
response if ${url} ~= /^https:\/\/api\.xiaoyuzhoufm\.com\/v\d+\/discovery-feed\/list(?:\?|$)/i then response.json.jq("if (.data | type) == \"array\" then .data |= map(select(if type == \"object\" then .type != \"DISCOVERY_BANNER\" else true end)) else . end")

[MitM]
hostname=api.xiaoyuzhoufm.com