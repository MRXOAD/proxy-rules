#!name=12306去广告
#!desc=过滤12306应用内广告及开屏广告
#!openUrl=https://apps.apple.com/app/id564818797
#!author=RuCu6[https://github.com/RuCu6], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/12306.png
#!date=2026-10-02 13:57:49
# 本地修改：rules/本地补充/可莉插件/12306_remove_ads.list（3 条）

[Rule]
DOMAIN, ad.12306.cn, DIRECT

[Rewrite]
response if ${url} ~= /^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList(?:\?[^#]*)?$/i then response.json.jq("if type == \"object\" then (.materialsList = [] | if (.advertParam | type) == \"object\" then .advertParam.skipTime = 1 else . end) else . end")

[Script]

request if ${url} ~= /^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm(?:\?[^#]*)?$/i then script("https://raw.githubusercontent.com/MRXOAD/proxy-rules/main/loon/plugins/KeLee-12306_remove_ads.js") with tag="移除12306应用内广告"

[MitM]
hostname=ad.12306.cn, mobile.12306.cn