#!name=华住会去广告
#!desc=移除华住会开屏广告、酒店列表横幅、首页推荐、营销弹窗及更新提示。
#!openUrl=https://apps.apple.com/app/id529285056
#!author=MRXOAD[https://github.com/MRXOAD]
#!tag=去广告
#!system=iOS, iPadOS
#!loon_version=3.5.1(978)
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/d8/44/3c/d8443c13-d8bf-2851-d7e7-42358d594b67/AppIcon-0-1x_U007ephone-0-11-0-85-220-0.png/512x512bb.jpg

[Rewrite]
# 开屏启动页（端口号不定，写成可选端口，主机声明才认得出来）
request if ${url} ~= /^https?:\/\/appapi\.huazhu\.com(?::\d+)?\/client\/app\/getAppStartPage\//i then reject(200)

# 酒店列表上方的 Banner 广告位
request if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/hotels\/ad\//i then reject_dict(200)

# 首页推荐信息
request if ${url} ~= /^https?:\/\/hweb-hotel\.huazhu\.com\/\/*home\/queryRecommond/i then reject_dict(200)

# 弹窗通知（营销弹窗与 App 启动通知共用此接口）
request if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/notice\/getAppPopupNotifyAlert/i then reject_dict(200)

# 强制更新检查
request if ${url} ~= /^https?:\/\/hweb-manager\.huazhu\.com\/bundle\/upgrade\/check/i then reject_dict(200)

[MITM]
hostname = appapi.huazhu.com, hweb-manager.huazhu.com, hweb-hotel.huazhu.com
